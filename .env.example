# QuoteIQ runs without provider credentials in demo mode.
QUOTEIQ_MODE=demo

# Required only when QUOTEIQ_MODE=live.
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=

# Optional provider model overrides.
QUOTEIQ_EXTRACTION_MODEL=gemini-2.5-pro
QUOTEIQ_REASONING_MODEL=gpt-5.4
QUOTEIQ_EMBEDDING_MODEL=text-embedding-3-large
